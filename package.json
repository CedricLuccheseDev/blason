{
  "name": "blason",
  "version": "0.5.42",
  "description": "A medieval real-time strategy game in the browser: twenty lords, a land drawn anew each game.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/CedricLuccheseDev/blason.git"
  },
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "npx srvx serve --prod --dir . --entry dist/server/server.js --static dist/client",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "knip": "knip",
    "depcruise": "depcruise src engine scripts net server",
    "norm": "node scripts/norm-check.mjs $(git ls-files 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.css')",
    "arena": "tsx scripts/arena.ts",
    "atlas": "tsx scripts/atlas.ts",
    "legend": "tsx scripts/legend.ts",
    "maquette": "tsx scripts/maquette.ts",
    "planches": "node design/maquette/planches.mjs",
    "census": "tsx scripts/census.ts",
    "maps": "tsx scripts/maps.ts",
    "relay": "tsx server/relay.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "d3-delaunay": "^6.0.4",
    "marked": "^18.1.1",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18",
    "eslint": "^10",
    "eslint-plugin-sonarjs": "^4",
    "knip": "^6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "clNorm": "2026-10-29"
}
